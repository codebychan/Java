class Animal {                  // Superclass
    void sound() {
        System.out.println("Animal makes a sound");
    }
}

class Dog extends Animal {      // Subclass

    @Override
    void sound() {
        System.out.println("Dog barks");
    }
}

public class Main {
    public static void main(String[] args) {
        Dog d = new Dog();

        d.sound();
    }
}
